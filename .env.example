PORT=3001
API_KEY=YOUR_API_KEY_HERE

# EMVCo string dari QR "Terima Uang"/QRIS merchant ShopeePay lo (decode gambar
# QR-nya jadi teks mentah). Bagian ini generic & ready — nggak butuh apa pun
# dari Partner Portal.
QRIS_STATIC=

# --- Diisi setelah akun ShopeePay Partner/merchant aktif ---
# Cara dapetin: login ke https://partner.shopee.co.id/ di browser biasa ->
# DevTools (F12) -> tab Network -> filter Fetch/XHR -> refresh halaman
# transaksi -> cari request "get-transaction-list" -> lihat Request Payload
# -> data -> metadata -> token. Copy nilainya ke sini (biasanya diawali "B:").
SHOPEE_TOKEN=

# URL endpoint get-transaction-list yang sama, copy dari DevTools juga
# (klik kanan request itu -> Copy -> Copy URL).
SHOPEE_TRANSACTIONS_URL=
